# Server-only credentials. Configure in Vercel Settings > Environment Variables.
# Neon Postgres connection string; automatically initializes content on first request.
DATABASE_URL=
# Use a unique admin password of at least 16 characters.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Optional: create a public Vercel Blob store for dashboard image uploads.
BLOB_READ_WRITE_TOKEN=
# Resend: verified sender address and the studio's recipient address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# LOCAL DEVELOPMENT ONLY. Never enable this on Vercel.
# KIRA_LOCAL_STORE=1
